[alias]
	s = status
	su = submodule update --init --recursive
	l = log --decorate --oneline --graph
	ld = log --decorate --graph --oneline  --pretty=format:'%C(yellow)%h %C(cyan)%ad %Cblue%aN%C(auto)%d %Creset%s' --date relative
	ldd = log --decorate --graph --oneline  --pretty=format:'%C(yellow)%h %C(cyan)%ad %Cblue%aN%C(auto)%d %Creset%s'
	lda = log --all --decorate --graph --oneline  --pretty=format:'%C(yellow)%h %C(cyan)%ad %Cblue%aN%C(auto)%d %Creset%s' --date relative
	la = log --all --decorate --oneline --graph
	ds = diff --staged
	dss = diff --stat --staged
	a = add
	c = checkout
	b = branch
	dw = diff --word-diff
	dsw = diff --staged --word-diff
	d = diff
	ra = rebase --abort
	rc = rebase --continue
	rs = rebase --show-current-patch
	ri = rebase --interactive --autosquash --autostash
	cv = commit --verbose
	ca = commit --amend --verbose
	cf = commit --fixup
	pff = push --force-with-lease --force-if-includes
	ap = add -p
	cp = cherry-pick
	cpa = cherry-pick --abort
	cpc = cherry-pick --continue
	ma = merge --abort
	mc = merge --continue
	lp = log -p
	st = stash
	stl = stash list
	sts = stash show
	stsh = stash show -p
	fp = fetch --prune
	f = fetch
	whatadded = log --diff-filter=A
[user]
	email = mzebrak@syncad.com
	name = Mateusz Żebrak
	signingkey = TOUPDATE
[credential]
	helper = --help
[core]
	editor = vim
	pager = delta
	excludesfile = ~/dotfiles/git/gitignore
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	line-numbers = true
	line-numbers-minus-style = red
	file-style = bold gold
	file-decoration-style = ul gold
	commit-decoration-style = pink box
	map-styles = bold purple => syntax firebrick, bold cyan => syntax seagreen
#	hunk-header-file-style = bold gold
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[commit]
	gpgsign = true
[gpg]
	program = gpg
